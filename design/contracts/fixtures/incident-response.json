{
  "format": "adaptive-artifacts/project-design@0.3.0",
  "project": "incident-response",
  "kind": "operations",
  "assessment": {
    "discontinuity": "high",
    "concurrency": "high",
    "investigation": "high",
    "decision_and_commitment_density": "high",
    "operational_risk": "high",
    "read_latency": "critical"
  },
  "overrides": [],
  "source_lock": {
    "catalog_version": "0.7.0",
    "catalog": "sha256:d7f0f1d05f8c67f638c0ff1b4ad738161f43c1ec970729709f8f2afc1d8c1eb1",
    "traits": "sha256:031651d57b0385097ad45aa5f52e62989432797ddf19e26701728359970a332d",
    "backends": "sha256:717457f0078f89913f64d0e832b0d4a57643a5474f503b11c443d7fa97e2ea37"
  },
  "backend": "git-filesystem",
  "records": [
    {
      "name": "current-position",
      "pattern": "current-status",
      "purpose": "Live position across a discontinuity",
      "canonical_for": "the live position of this subject",
      "capture": "at_event",
      "read": "always",
      "payload": [
        "position",
        "scope"
      ]
    },
    {
      "name": "active-goal",
      "pattern": "current-status",
      "purpose": "Live goal",
      "canonical_for": "the live goal of this subject",
      "capture": "at_event",
      "read": "always",
      "payload": [
        "goal",
        "scope"
      ]
    },
    {
      "name": "next-action",
      "pattern": "current-status",
      "purpose": "Live next action",
      "canonical_for": "the live next action of this subject",
      "capture": "at_event",
      "read": "always",
      "payload": [
        "next",
        "scope"
      ]
    },
    {
      "name": "active-commitment",
      "pattern": "commitment",
      "purpose": "Live undertaking",
      "canonical_for": "the live undertaking of this actor",
      "capture": "at_event",
      "read": "always",
      "payload": [
        "actor",
        "outcome",
        "owner",
        "effective_time",
        "scope"
      ]
    },
    {
      "name": "continuity-question",
      "pattern": "question",
      "purpose": "Blocking unknown for session continuity",
      "canonical_for": "whether this unknown blocks continuity",
      "capture": "at_event",
      "read": "always",
      "payload": [
        "owner",
        "blocking",
        "scope"
      ]
    },
    {
      "name": "investigation-question",
      "pattern": "question",
      "purpose": "Unknown under investigation",
      "canonical_for": "the open investigation unknown",
      "capture": "at_event",
      "read": "if_relevant",
      "payload": [
        "motivation",
        "owner"
      ]
    },
    {
      "name": "investigation-observation",
      "pattern": "observation",
      "purpose": "What was observed during investigation",
      "canonical_for": "what was observed in this investigation",
      "capture": "at_event",
      "read": "query",
      "payload": [
        "source",
        "observed_time",
        "environment",
        "what_was_observed"
      ]
    },
    {
      "name": "finding",
      "pattern": "finding",
      "purpose": "Contingent investigation conclusion",
      "canonical_for": "the investigation conclusion for this claim",
      "capture": "at_event",
      "read": "if_relevant",
      "payload": [
        "claim",
        "basis",
        "invalidated_when"
      ]
    },
    {
      "name": "failed-attempt",
      "pattern": "event",
      "purpose": "Abandoned approach",
      "canonical_for": "that this approach was abandoned",
      "capture": "at_event",
      "read": "if_relevant",
      "payload": [
        "attempted_action",
        "retry_when"
      ]
    }
  ],
  "views": [
    {
      "name": "handoff",
      "owns_facts": false,
      "freshness": "on_demand_or_handoff",
      "parameters": [
        "group_by"
      ],
      "roles": [
        {
          "name": "goal",
          "occupant": "active-goal",
          "requires_payload": [
            "goal",
            "scope"
          ],
          "selection": {
            "all": [
              {
                "field": "lifecycle_state",
                "equals": "active"
              }
            ]
          }
        },
        {
          "name": "position",
          "occupant": "current-position",
          "requires_payload": [
            "position",
            "scope"
          ],
          "selection": {
            "all": [
              {
                "field": "lifecycle_state",
                "equals": "active"
              }
            ]
          }
        },
        {
          "name": "next",
          "occupant": "next-action",
          "requires_payload": [
            "next",
            "scope"
          ],
          "selection": {
            "all": [
              {
                "field": "lifecycle_state",
                "equals": "active"
              }
            ]
          }
        },
        {
          "name": "commitment",
          "occupant": "active-commitment",
          "requires_payload": [
            "scope"
          ],
          "selection": {
            "all": [
              {
                "field": "lifecycle_state",
                "equals": "active"
              }
            ]
          }
        },
        {
          "name": "blocking-question",
          "occupant": "continuity-question",
          "requires_payload": [
            "blocking",
            "scope"
          ],
          "selection": {
            "all": [
              {
                "field": "lifecycle_state",
                "equals": "open"
              },
              {
                "field": "payload.blocking",
                "equals": true
              }
            ]
          }
        }
      ]
    },
    {
      "name": "investigation-summary",
      "owns_facts": false,
      "freshness": "on_demand",
      "parameters": [
        "group_by",
        "order_by"
      ],
      "roles": [
        {
          "name": "question",
          "occupant": "investigation-question",
          "selection": {
            "all": []
          },
          "requires_payload": [
            "motivation",
            "owner"
          ]
        },
        {
          "name": "observation",
          "occupant": "investigation-observation",
          "selection": {
            "all": []
          },
          "requires_payload": [
            "source",
            "what_was_observed"
          ]
        },
        {
          "name": "finding",
          "occupant": "finding",
          "selection": {
            "all": []
          },
          "requires_payload": [
            "claim",
            "basis"
          ]
        },
        {
          "name": "failed-attempt",
          "occupant": "failed-attempt",
          "selection": {
            "all": []
          },
          "requires_payload": [
            "attempted_action",
            "retry_when"
          ]
        }
      ]
    }
  ],
  "bundles": [
    {
      "name": "session-continuity",
      "optional": true,
      "records": [
        "current-position",
        "active-commitment",
        "continuity-question",
        "active-goal",
        "next-action"
      ],
      "capture": {
        "trigger": [
          "session_boundary"
        ]
      }
    },
    {
      "name": "abandoned-path",
      "optional": true,
      "records": [
        "failed-attempt",
        "investigation-observation"
      ],
      "relationships": [
        {
          "from": "failed-attempt",
          "to": "investigation-observation",
          "type": "informed_by"
        }
      ],
      "capture": {
        "trigger": [
          "attempt_abandoned"
        ]
      }
    },
    {
      "name": "concluded-investigation",
      "optional": true,
      "records": [
        "investigation-question",
        "investigation-observation",
        "finding"
      ],
      "capture": {
        "trigger": [
          "investigation_concluded"
        ]
      }
    }
  ],
  "view_params": {
    "project:handoff": {
      "group_by": "response_role"
    },
    "project:investigation-summary": {
      "order_by": "current_relevance"
    }
  },
  "source_revisions": {
    "monitoring": "timestamped_query",
    "command_output": "timestamped_capture",
    "code": "deployed_revision"
  },
  "occupancy": {},
  "experimental_candidates": [
    {
      "namespace": "operations",
      "name": "incident-position",
      "traits": [
        "entity",
        "stewarded",
        "current-claim"
      ],
      "payload": [
        "position",
        "severity",
        "commander",
        "phase",
        "scope"
      ],
      "role_compatibility": {
        "view": "project:handoff",
        "role": "position"
      }
    },
    {
      "namespace": "operations",
      "name": "diagnosis",
      "traits": [
        "entity",
        "epistemic-claim"
      ],
      "payload": [
        "claim",
        "basis",
        "confidence"
      ],
      "role_compatibility": {
        "view": "project:investigation-summary",
        "role": "finding"
      }
    },
    {
      "namespace": "operations",
      "name": "intervention",
      "traits": [
        "entity",
        "stewarded",
        "active-undertaking"
      ],
      "payload": [
        "authorization",
        "target",
        "expected_effect",
        "scope"
      ],
      "role_compatibility": {
        "view": "project:handoff",
        "role": "commitment"
      }
    }
  ],
  "gaps": [
    {
      "future_type": "incident",
      "belongs_in_family": "operations",
      "would_occupy": null,
      "must_provide_traits": [
        "entity"
      ],
      "base_kind": "event",
      "extra_payload": [
        "severity",
        "commander",
        "declared_at",
        "resolved_at"
      ],
      "rationale": "Declaration and resolution are not the current-claim lifecycle, so this type cannot occupy the position role."
    },
    {
      "future_type": "incident-event",
      "belongs_in_family": "operations",
      "would_occupy": null,
      "must_provide_traits": [
        "entity",
        "occurrence"
      ],
      "base_kind": "event",
      "extra_payload": [
        "occurred_at",
        "actor",
        "source"
      ],
      "rationale": "Timeline events share occurrence but are not failed attempts; they would need their own view role."
    },
    {
      "need": "operational decisions with explicit approval authority",
      "belongs_in_family": "operations",
      "would_occupy": null
    },
    {
      "need": "postmortem actions as commitments with organizational ownership",
      "belongs_in_family": "operations",
      "would_occupy": null
    }
  ]
}
