      }
    },
    {
      "namespace": "research",
      "name": "experimental-observation",
      "traits": [
        "entity",
        "occurrence"
      ],
      "base_kind": "observation",
      "payload": [
        "source",
        "what_was_observed",
        "run",
        "instrument"
      ],
      "role_compatibility": {
        "view": "project:investigation-summary",
        "role": "observation"
      }
    }
  ],
  "gaps": [
    {
      "future_type": "experiment-run",
      "belongs_in_family": "research",
      "would_occupy": null,
      "must_provide_traits": [
        "entity"
      ],
      "base_kind": "event",
      "extra_payload": [
        "inputs",
        "parameters",
        "seeds",
        "environment",
        "outputs"
      ],
      "rationale": "A reproducible run is not an occurrence-correction contract and does not occupy failed-attempt."
    },
    {
      "future_type": "protocol",
      "belongs_in_family": "research",
      "would_occupy": null,
      "must_provide_traits": [
        "entity"
      ],
      "base_kind": "definition",
      "extra_payload": [
        "version",
        "procedure"
      ]
    },
    {
      "need": "dataset and model lineage stronger than exploration provenance",
      "belongs_in_family": "research",
      "would_occupy": null
    },
    {
      "need": "independent replication as distinct from rerunning the same computation",
      "belongs_in_family": "research",
      "would_occupy": null
    }
  ]
}
